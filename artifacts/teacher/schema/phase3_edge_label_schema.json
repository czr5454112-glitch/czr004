{
  "schema_version": "phase3_edge_label_v1",
  "description": "One JSONL row per directed map edge after a LaCAM*+LTM teacher run.",
  "required_fields": [
    "schema_version",
    "run_id",
    "source",
    "method",
    "map",
    "scen",
    "agents",
    "seed",
    "time_limit_sec",
    "objective",
    "from_id",
    "to_id",
    "from_index",
    "to_index",
    "from_x",
    "from_y",
    "to_x",
    "to_y",
    "from_degree",
    "to_degree",
    "ltm_raw_count",
    "ltm_normalized_weight",
    "warm_start_target_weight",
    "residual_reference_weight",
    "residual_delta_target",
    "traversal_cost",
    "nonzero",
    "map_vertices"
  ],
  "weight_range": [0, 10],
  "primary_supervision": "online_residual",
  "warm_start_target": "ltm_normalized_edge_weight"
}
